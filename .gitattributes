# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Force Unix line endings for shell scripts (critical for Termux / Linux)
*.sh text eol=lf

# JavaScript, HTML, CSS, JSON, Markdown
*.js text eol=lf
*.mjs text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf

# Binary image formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
